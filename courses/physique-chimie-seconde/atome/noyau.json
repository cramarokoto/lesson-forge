    "Z = \\text{nombre de protons}",
    "N = \\text{nombre de neutrons}, \\qquad A = Z + N",
    "{}^{A}_{Z}\\mathrm{X} \\qquad {}^{7}_{3}\\mathrm{Li}",
    "A = Z + N \\geq Z",
    "N = A - Z, \\qquad {}^{13}_{6}\\mathrm{C} : N = 13 - 6 = 7",
    "{}^{23}\\mathrm{Na}, \\ Z = 11 \\text{ (donné)} : N = 23 - 11 = 12",
    "{}^{16}_{8}\\mathrm{O} : 8 \\text{ protons}, \\ 16 - 8 \\text{ neutrons}"
