{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Concise",
  "permissions": {
    "allow": [
      "Bash(bash scripts/check.sh *)",
      "Bash(scripts/check.sh *)",
      "Bash(node scripts/validate.mjs *)",
      "Bash(node scripts/build.mjs *)",
      "Bash(npm ci)",
      "Bash(npx playwright test *)",
      "Edit(courses/**)",
      "Edit(work/**)",
      "Bash(node scripts/snapshot.mjs *)",
      "Bash(node scripts/sources-cache.mjs *)",
      "Bash(node scripts/review-page.mjs *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(netlify *)",
      "Bash(npx netlify *)",
      "Bash(npx gh-pages *)",
      "Bash(wrangler *)",
      "Bash(npx wrangler *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.mjs\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/reviewer-write-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
